# LabGenie AI — Backend Environment Variables
# Copy this file to .env and fill in the values before running the backend.
# Never commit the real .env file to version control.

# Port on which the Express server listens
PORT=5000

# IBM Granite API endpoint (will be needed in Phase 2)
# IBM_GRANITE_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation

# IBM Cloud API key for watsonx.ai (will be needed in Phase 2)
# IBM_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai project ID (will be needed in Phase 2)
# IBM_PROJECT_ID=your_project_id_here
