# LabGenie AI — Frontend Environment Variables
# Copy this file to .env and fill in the values before running the frontend.
# Never commit the real .env file to version control.
# All Vite env variables must be prefixed with VITE_ to be exposed to the browser.

# Backend API base URL (leave blank to use Vite's dev proxy, i.e. /api)
# VITE_API_BASE_URL=http://localhost:5000/api
