# LabGenie AI — Backend Environment Variables
# Copy this file to .env and fill in the values before running the backend.
# Never commit the real .env file to version control.

# Port on which the Express server listens
PORT=5000

# IBM watsonx.ai API key
WATSONX_API_KEY=your_ibm_watsonx_api_key_here

# IBM watsonx.ai project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai endpoint
WATSONX_URL=https://us-south.ml.cloud.ibm.com